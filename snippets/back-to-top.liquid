{% doc %}
  Renders a fixed "back to top" button at the bottom right of the viewport.
  It stays hidden (and inert) until the shopper has scrolled down one viewport height.
  Rendered from `layout/theme.liquid` when the `show_back_to_top` theme setting is on.

  Also defines the shared `--floating-button-*` custom properties used by the
  floating cart section so the two buttons never overlap each other or the
  sticky add-to-cart bar.

  @example
  {% render 'back-to-top' %}
{% enddoc %}

<script
  src="{{ 'back-to-top.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<back-to-top-button
  class="back-to-top"
  inert
>
  <button
    type="button"
    class="back-to-top__button button-unstyled"
    on:click="/scrollToTop"
    aria-label="{{ 'accessibility.back_to_top' | t }}"
  >
    <span
      class="svg-wrapper icon-caret back-to-top__icon"
      aria-hidden="true"
    >
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </button>
</back-to-top-button>

{% stylesheet %}
  /* Shared by the back-to-top button and the floating cart section (spec 001, AC4.4).
     Also declared in sections/floating-cart.liquid with identical values; keep the two in sync. */
  :root {
    --floating-button-size: 48px;
    --floating-button-inset: 16px;
    --floating-button-gap: 12px;
    --floating-sticky-offset: 88px;
  }

  @media screen and (min-width: 750px) {
    :root {
      --floating-button-size: 56px;
      --floating-button-inset: 24px;
      --floating-sticky-offset: 96px;
    }
  }

  /* Lift bottom-anchored floating buttons above the stuck sticky add-to-cart bar. */
  body:has(.sticky-add-to-cart__bar[data-stuck='true']) {
    --floating-sticky-offset-current: var(--floating-sticky-offset);
  }

  .back-to-top {
    position: fixed;
    z-index: var(--layer-heightened);
    inset-inline-end: var(--floating-button-inset);
    inset-block-end: calc(var(--floating-button-inset) + var(--floating-sticky-offset-current, 0px));
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--animation-speed) var(--animation-easing),
      visibility var(--animation-speed) var(--animation-easing);
  }

  .back-to-top[data-visible] {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile: stack above the floating cart button when one is on the page. */
  @media screen and (max-width: 749px) {
    body:has(.floating-cart) .back-to-top {
      inset-block-end: calc(
        var(--floating-button-inset) + var(--floating-button-size) + var(--floating-button-gap) +
          var(--floating-sticky-offset-current, 0px)
      );
    }
  }

  .back-to-top__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--floating-button-size);
    height: var(--floating-button-size);
    border-radius: 50%;
    background-color: var(--color-foreground);
    color: var(--color-background);
    cursor: pointer;
  }

  .back-to-top__button:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .back-to-top__icon {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  .back-to-top__icon svg {
    width: 100%;
    height: 100%;
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
{% endstylesheet %}
