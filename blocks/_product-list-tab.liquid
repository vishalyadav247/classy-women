{%- doc -%}
  Product list tab (private to `sections/product-list.liquid`).

  Holds the settings for one tab: a label and a collection. The block itself renders nothing.
  `sections/product-list.liquid` reads every `_product-list-tab` block from `section.blocks`,
  drops tabs whose collection is blank or has no products, and renders the tab buttons
  (through `snippets/product-list-tablist.liquid`, which outputs `block.shopify_attributes` so
  the block stays selectable in the theme editor) and one product panel per tab.
  The tab label falls back to the collection title when it is blank.
{%- enddoc -%}

{% schema %}
{
  "name": "t:names.product_list_tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_list_tab"
    }
  ]
}
{% endschema %}
