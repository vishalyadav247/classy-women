{%- doc -%}
  Renders an accessible breadcrumb trail: a "Home" link to the storefront root, then the
  current page's title (not linked, marked with aria-current="page").
  The current title is picked by `request.page_type` (collection, product, article, blog, page),
  falling back to the global `page_title` on other templates. On the home page only "Home" renders.
  Public block, usable in any section that accepts `@theme` blocks.

  @example
  {% content_for 'block', type: 'breadcrumb', id: 'breadcrumb' %}
{%- enddoc -%}

{%- liquid
  assign current_title = blank

  case request.page_type
    when 'collection'
      assign current_title = collection.title
    when 'product'
      assign current_title = product.title
    when 'article'
      assign current_title = article.title
    when 'blog'
      assign current_title = blog.title
    when 'page'
      assign current_title = page.title
    when 'index'
      assign current_title = blank
    else
      assign current_title = page_title
  endcase

  assign is_home = false
  if request.page_type == 'index' or current_title == blank
    assign is_home = true
  endif
-%}

<nav
  class="breadcrumb spacing-style breadcrumb--{{ block.settings.alignment }}"
  aria-label="{{ 'accessibility.breadcrumb' | t }}"
  style="
    {% render 'spacing-style', settings: block.settings %}
    --breadcrumb-font-size: var(--font-size--{{ block.settings.text_size }});
  "
  {{ block.shopify_attributes }}
>
  <ol class="breadcrumb__list">
    <li class="breadcrumb__item">
      {%- if is_home -%}
        <span aria-current="page">{{ 'content.breadcrumb_home' | t }}</span>
      {%- else -%}
        <a
          class="breadcrumb__link"
          href="{{ routes.root_url }}"
        >
          {{- 'content.breadcrumb_home' | t -}}
        </a>
      {%- endif -%}
    </li>
    {%- unless is_home -%}
      <li class="breadcrumb__item">
        {%- if block.settings.separator != blank -%}
          <span
            class="breadcrumb__separator"
            aria-hidden="true"
          >
            {{- block.settings.separator | escape -}}
          </span>
        {%- endif -%}
        <span aria-current="page">{{ current_title | escape }}</span>
      </li>
    {%- endunless -%}
  </ol>
</nav>

{% stylesheet %}
  .breadcrumb {
    width: 100%;
    font-size: var(--breadcrumb-font-size, var(--font-size--xs));
    line-height: var(--line-height--body-normal, 1.5);
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb--center .breadcrumb__list {
    justify-content: center;
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .breadcrumb__link {
    color: currentcolor;
  }

  .breadcrumb__link:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.7);
  }

  .breadcrumb__link:focus-visible {
    outline: var(--focus-outline-width, 2px) solid currentcolor;
    outline-offset: var(--focus-outline-offset, 2px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.breadcrumb",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "separator",
      "label": "t:settings.separator",
      "default": "/"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "xs",
          "label": "t:options.extra_small"
        },
        {
          "value": "sm",
          "label": "t:options.small"
        },
        {
          "value": "md",
          "label": "t:options.medium"
        }
      ],
      "default": "xs"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.breadcrumb",
      "category": "t:categories.links"
    }
  ]
}
{% endschema %}
