{%- liquid
  assign block_settings = block.settings
  assign photos_mode = false
  if block_settings.swatch_style == 'photos'
    assign photos_mode = true
  endif

  # Same option choice as variant-swatches: first option with swatches, else first option named in settings.swatch_option_names.
  assign swatch_option_names = settings.swatch_option_names | downcase | remove: ' ' | split: ','
  assign swatch_value_count = 0
  for product_option in closest.product.options_with_values
    assign swatch_count = product_option.values | map: 'swatch' | compact | size

    if swatch_count > 0
      assign swatch_value_count = product_option.values.size
      break
    endif

    assign option_name = product_option.name | downcase | remove: ' '
    if swatch_value_count == 0 and swatch_option_names contains option_name
      assign swatch_value_count = product_option.values.size
    endif
  endfor

  if swatch_value_count > 0
    assign product_has_swatches = true
  endif

  if photos_mode and block_settings.hide_single_value and swatch_value_count < 2
    assign product_has_swatches = false
  endif
-%}

{% stylesheet %}
  product-swatches {
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
    gap: 0;
    flex-shrink: 0;
  }

  /* Photo thumbnails (swatch_style: photos). Vars live on <product-swatches>, outside the morphed picker. */
  .product-swatches--photos {
    swatches-variant-picker-component overflow-list::part(list) {
      gap: var(--card-swatch-gap);
    }

    .swatch {
      --swatch-width: var(--card-swatch-size-mobile);
      --swatch-height: var(--card-swatch-size-mobile);
      --style-border-swatch-width: 1px;
      --style-border-swatch-style: solid;
      --color-border: rgb(var(--color-foreground-rgb) / var(--opacity-15));

      border-radius: var(--card-swatch-radius);
      background-size: cover;

      @media screen and (min-width: 750px) {
        --swatch-width: var(--card-swatch-size);
        --swatch-height: var(--card-swatch-size);
      }
    }

    .variant-option__button-label--has-swatch {
      --focus-outline-radius: var(--card-swatch-radius);
    }

    /* Selected: 1px foreground border on the thumbnail instead of the offset outline. */
    .variant-option__button-label--has-swatch:has(:checked) .swatch {
      --color-border: var(--color-foreground);
    }

    .variant-option__button-label--has-swatch:has(:checked):not(:has(:focus-visible)) {
      outline: none;
    }

    @supports not (background-color: rgb(from red 150 g b / alpha)) {
      .variant-option__button-label--has-swatch:has(:checked):not(:has(:focus-visible))::after {
        content: none;
      }
    }

    /* Unavailable: faded thumbnail, Horizon strike-through kept. */
    .variant-option__button-label--has-swatch:has([data-option-available='false']) .swatch {
      opacity: var(--opacity-50);
    }
  }
{% endstylesheet %}

{% if product_has_swatches %}
  <product-swatches
    {% if photos_mode %}
      class="product-swatches--photos"
    {% endif %}
    data-product-id="{{ closest.product.id }}"
    data-product-url="{{ closest.product.url }}"
    style="
      --overflow-list-alignment: {{ block_settings.product_swatches_alignment }};
      --overflow-list-alignment-mobile: {{ block_settings.product_swatches_alignment_mobile }};
      --product-swatches-alignment: {% if block_settings.product_swatches_alignment == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-alignment-mobile: {% if block_settings.product_swatches_alignment_mobile == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment_mobile == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-padding-block-start: {{ block_settings.product_swatches_padding_top }}px;
      --product-swatches-padding-block-end: {{ block_settings.product_swatches_padding_bottom }}px;
      --product-swatches-padding-inline-start: {{ block_settings.product_swatches_padding_left }}px;
      --product-swatches-padding-inline-end: {{ block_settings.product_swatches_padding_right }}px;
      {% if photos_mode %}
        {%- assign swatch_size_mobile = block_settings.thumbnail_size | times: 0.85 | at_least: 24 -%}
        --card-swatch-size: {{ block_settings.thumbnail_size }}px;
        --card-swatch-size-mobile: {{ swatch_size_mobile }}px;
        --card-swatch-radius: {{ block_settings.thumbnail_radius }}px;
        --card-swatch-gap: {{ block_settings.thumbnail_gap }}px;
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {% if photos_mode %}
      {% render 'variant-swatches', product_resource: closest.product, has_option_selected: true %}
    {% else %}
      {% render 'variant-swatches', product_resource: closest.product %}
    {% endif %}
  </product-swatches>
{% endif %}

{% schema %}
{
  "name": "t:names.swatches",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_swatches"
    },
    {
      "type": "select",
      "id": "product_swatches_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "product_swatches_alignment_mobile",
      "label": "t:settings.alignment_mobile",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "swatch_style",
      "label": "t:settings.swatch_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "photos",
          "label": "t:options.product_photos"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "t:settings.size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ block.settings.swatch_style == 'photos' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.swatch_style == 'photos' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.swatch_style == 'photos' }}"
    },
    {
      "type": "checkbox",
      "id": "hide_single_value",
      "label": "t:settings.hide_single_swatch",
      "default": false,
      "visible_if": "{{ block.settings.swatch_style == 'photos' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding",
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "checkbox",
      "id": "hide_padding",
      "label": "t:settings.hide_padding",
      "default": false,
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_left",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_right",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.swatches",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
