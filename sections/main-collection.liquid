

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% liquid
        assign products_per_page = section.settings.products_per_page | default: 24

        assign load_more_button = false
        if section.settings.enable_infinite_scroll and section.settings.load_trigger == 'button'
          assign load_more_button = true
        endif
      %}

      {% paginate collection.products by products_per_page %}
        {% liquid
          # Promo tiles: Grid layout, first page only, optionally hidden while filters are active
          assign show_promos = false
          if paginate.current_page == 1 and section.settings.layout_type == 'grid'
            assign show_promos = true
          endif

          if show_promos and section.settings.show_promos_when_filtered == false
            for filter in collection.filters
              case filter.type
                when 'price_range'
                  if filter.min_value.value != null or filter.max_value.value != null
                    assign show_promos = false
                  endif
                when 'boolean'
                  if filter.active_values[0].value
                    assign show_promos = false
                  endif
                else
                  if filter.active_values.size > 0
                    assign show_promos = false
                  endif
              endcase
            endfor
          endif

          assign promo_chunks = '' | split: ','
          assign promo_cells_used = 0

          # Fixed desktop columns let a tile be skipped when too few products follow to fill its row(s)
          assign promo_columns = 0
          if section.settings.grid_columns != blank and section.settings.grid_columns != 'auto'
            assign promo_columns = section.settings.grid_columns | plus: 0
          endif

          # Dense grid flow whenever this section can hold tiles, on every page (tiles may be prepended later)
          assign has_promos = false
          if section.settings.layout_type == 'grid'
            for promo_block in section.blocks
              if promo_block.type == '_collection-promo-tile'
                if promo_block.settings.media_type == 'video'
                  assign promo_media = promo_block.settings.video
                else
                  assign promo_media = promo_block.settings.image
                endif

                if promo_media != blank or request.design_mode
                  assign has_promos = true
                  break
                endif
              endif
            endfor
          endif
        %}

        {% if show_promos %}
          {% capture promo_output %}{% content_for 'blocks' %}{% endcapture %}
          {% assign promo_chunks = promo_output | split: '<!--promo:' %}
        {% endif %}

        {% capture children %}
          {% for product in collection.products %}
            {%- for promo_chunk in promo_chunks offset: 1 -%}
              {%- assign promo_marker = promo_chunk | split: '-->' | first -%}
              {%- assign promo_parts = promo_marker | split: ',' -%}
              {%- assign promo_position = promo_parts[0] | plus: 0 -%}
              {%- if promo_position == forloop.parentloop.index0 -%}
                {%- liquid
                  assign promo_fits = true
                  assign promo_rows = 1
                  if promo_parts[1] == '2x2'
                    assign promo_rows = 2
                  endif
                  assign promo_cells = promo_rows | times: 2

                  if promo_columns > 0
                    # Row the tile lands in, assuming earlier items pack from the start of the grid
                    assign promo_used = promo_position | plus: promo_cells_used
                    assign promo_row = promo_used | divided_by: promo_columns
                    assign promo_row_used = promo_used | modulo: promo_columns
                    if promo_row_used > 0
                      assign promo_row_free = promo_columns | minus: promo_row_used
                      unless promo_parts[2] == 'right' and promo_row_free >= 2
                        assign promo_row = promo_row | plus: 1
                      endunless
                    endif

                    # Products needed after the tile to fill every cell up to the end of its last row
                    assign promo_needed = promo_row | plus: promo_rows | times: promo_columns | minus: promo_used | minus: promo_cells
                    assign promo_following = collection.products.size | minus: promo_position
                    if promo_following < promo_needed
                      assign promo_fits = false
                    endif
                  endif
                -%}
                {%- if promo_fits -%}
                  {%- assign promo_cells_used = promo_cells_used | plus: promo_cells -%}
                  {%- assign promo_marker_size = promo_marker.size | plus: 3 -%}
                  {{- promo_chunk | slice: promo_marker_size, promo_chunk.size -}}
                {%- endif -%}
              {%- endif -%}
            {%- endfor %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% content_for 'block',
                type: '_product-card',
                id: 'product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll,
          has_promos: has_promos,
          load_more_button: load_more_button
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    {
      "type": "_collection-promo-tile"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "t:settings.columns",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        },
        {
          "value": "3",
          "label": "t:options.three_number"
        },
        {
          "value": "4",
          "label": "t:options.four_number"
        },
        {
          "value": "5",
          "label": "t:options.five_number"
        },
        {
          "value": "6",
          "label": "t:options.six_number"
        }
      ],
      "default": "auto",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.grid_columns == 'auto' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.load_products_without_reload",
      "info": "t:info.pagination_numbered_when_off",
      "default": true
    },
    {
      "type": "select",
      "id": "load_trigger",
      "label": "t:settings.load_trigger",
      "options": [
        {
          "value": "scroll",
          "label": "t:options.on_scroll"
        },
        {
          "value": "button",
          "label": "t:options.load_more_button"
        }
      ],
      "default": "scroll",
      "visible_if": "{{ section.settings.enable_infinite_scroll }}"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.promo_tiles"
    },
    {
      "type": "checkbox",
      "id": "show_promos_when_filtered",
      "label": "t:settings.show_promos_when_filtered",
      "info": "t:info.promo_tiles",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
