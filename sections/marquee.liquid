

<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign gap_between_elements = section.settings.gap_between_elements
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<marquee-component
  class="section spacing-style gap-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% unless request.design_mode %} marquee--hide-empty{% endunless %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    {% render 'gap-style', value: gap_between_elements, name: 'marquee-gap' %}
    --marquee-direction: {{ section.settings.movement_direction }};
    --marquee-image-height: {{ section.settings.image_height }}px;
    --marquee-image-height-mobile: {{ section.settings.image_height_mobile }}px;
  "
  data-speed-factor="{{ section.settings.speed }}"
  data-movement-direction="{{ section.settings.movement_direction }}"
>
  {%- if section.settings.heading != blank -%}
    {% render 'text-block-styles' %}
    <div class="text-block section-heading marquee__heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div
    class="marquee__wrapper"
    ref="wrapper"
  >
    <div
      class="marquee__content"
      ref="content"
    >
      <div
        class="marquee__repeated-items"
        ref="marqueeItems[]"
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</marquee-component>

{% stylesheet %}
  marquee-component {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .marquee__wrapper {
    display: flex;
    gap: var(--marquee-gap);
    width: fit-content;
    white-space: nowrap;
  }

  .marquee__content {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
  }

  .marquee__content :is(p, h1, h2, h3, h4, h5, h6) {
    white-space: nowrap;
  }

  .marquee__content .marquee__repeated-items * {
    max-width: none;
  }

  .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
    align-items: center;
    justify-content: center;
  }

  .marquee__repeated-items > * {
    align-content: center;
  }

  .marquee__heading {
    margin-block-end: var(--padding-xl);
  }

  /* Logo images (image blocks): fixed height, natural width, original colours (no filter). */
  .marquee__repeated-items :is(.image-block__image, .placeholder-image) {
    height: var(--marquee-image-height-mobile);
    width: auto;
    aspect-ratio: auto;
    object-fit: contain;
  }

  .marquee__repeated-items .placeholder-image {
    aspect-ratio: 3 / 1;
  }

  @media screen and (min-width: 750px) {
    .marquee__repeated-items :is(.image-block__image, .placeholder-image) {
      height: var(--marquee-image-height);
    }
  }

  /* Outside the editor, skip logo blocks that have no image. */
  .marquee--hide-empty .marquee__repeated-items .placeholder-image,
  .marquee--hide-empty .marquee__repeated-items .image-block:has(> .placeholder-image) {
    display: none;
  }

  /* Reduced motion: no animation (see below) and no clones (marquee.js), so offer a static, scrollable row. */
  @media (prefers-reduced-motion: reduce) {
    marquee-component .marquee__wrapper {
      grid-column: 1 / -1;
      width: auto;
      max-width: 100%;
      overflow-x: auto;
      scroll-snap-type: none;
      padding-inline: var(--page-margin);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Span the full section width (bleed past the page margins) so the moving row has no visible start edge
       and doesn't pop when the loop resets. The heading keeps the content column. */
    marquee-component:not([data-disabled]) .marquee__wrapper {
      grid-column: 1 / -1;
      animation: marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.marquee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "logo"
    },
    {
      "type": "_divider"
    },
    {
      "type": "image"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "select",
      "id": "movement_direction",
      "label": "t:settings.motion_direction",
      "options": [
        {
          "value": "reverse",
          "label": "t:options.forward"
        },
        {
          "value": "normal",
          "label": "t:options.reverse"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.speed",
      "info": "t:info.marquee_speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 25
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "t:settings.image_height",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "t:settings.image_height_mobile",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_between_elements",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.marquee_section",
      "category": "t:categories.text",
      "blocks": {
        "text": {
          "type": "text",
          "settings": {
            "text": "t:html_defaults.make_things_better",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h2)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["text"]
    }
  ]
}
{% endschema %}
