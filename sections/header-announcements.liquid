{% liquid
  # Count the messages that actually render. `_announcement` skips blocks whose text is blank,
  # so `section.blocks.size` would overcount (empty bar, or arrows for a single message).
  assign visible_count = 0
  for block in section.blocks
    assign plain_text = block.settings.text | strip_newlines | strip_html | strip
    if plain_text != ''
      assign visible_count = visible_count | plus: 1
    endif
  endfor
%}

{% if visible_count > 0 %}
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if visible_count > 1
      assign show_arrows = true
      if section.settings.autoplay
        assign autoplay = true
      endif
    endif

    assign bar_modifiers = ''
    if section.settings.arrows_position == 'beside_message'
      assign bar_modifiers = bar_modifiers | append: ' announcement-bar--arrows-beside'
    endif
    if section.settings.underline_links
      assign bar_modifiers = bar_modifiers | append: ' announcement-bar--underline-links'
    endif
  %}

  {% capture slides %}{% content_for 'blocks' %}{% endcapture %}
  {% comment %}
    `_announcement` marks only `section.blocks[0]` as visible. When that block has blank text it
    renders nothing, so no slide starts visible: show the first rendered slide instead.
  {% endcomment %}
  {% unless slides contains 'aria-hidden="false"' %}
    {% assign slides = slides | replace_first: 'aria-hidden="true"', 'aria-hidden="false"' %}
  {% endunless %}

  {% if show_arrows %}
    <script
      src="{{ 'announcement-bar.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {% endif %}

  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

  <div class="section-background color-custom-{{ section.id }}"></div>
  <aside
    class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}{{ bar_modifiers }}"
    style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
  >
    <announcement-bar-component
      class="announcement-bar__slider"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="announcement-bar__slides">
        {{ slides }}
      </div>
    </announcement-bar-component>
  </aside>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  /* Prevent text descenders from being clipped by inherited slideshow-styles */
  .announcement-bar__slide {
    place-content: center;
    overflow: visible;
    min-width: 0;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .announcement-bar--underline-links .announcement-bar__slide:has(.announcement-bar__link) .announcement-bar__text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Keep the arrows next to the centred message (slides max-width is 680px) instead of the page edges. */
  @media screen and (min-width: 750px) {
    .announcement-bar--arrows-beside .announcement-bar__slider slideshow-arrows {
      inset-inline: max(0px, calc(50% - 340px - var(--button-size)));
    }
  }

  /* Mobile: long messages wrap to at most 2 lines and never run under the arrows. */
  @media screen and (max-width: 749px) {
    .announcement-bar__slide .announcement-bar__text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "arrows_position",
      "label": "t:settings.arrows_position",
      "options": [
        {
          "value": "edges",
          "label": "t:options.page_edges"
        },
        {
          "value": "beside_message",
          "label": "t:options.beside_message"
        }
      ],
      "default": "edges"
    },
    {
      "type": "checkbox",
      "id": "underline_links",
      "label": "t:settings.underline_links",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
